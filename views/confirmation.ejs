<%- include('includes/header') %>

<div class="page-header page-header--compact" style="padding-top:100px;">
  <span class="page-header__eyebrow">Reservation Confirmed</span>
  <h1 class="page-header__title">Thank You, <%= booking.full_name ? booking.full_name.split(' ')[0] : 'Guest' %></h1>
  <p class="page-header__desc">
    Your reservation request has been received. Our concierge will review and contact you shortly.
  </p>
</div>

<section class="section" style="padding-top:0;">
  <div class="container container--sm">

    <div class="confirm-card" style="background:#fff; border-radius:18px; padding:36px; border:1px solid rgba(27,20,16,0.1); box-shadow:0 8px 30px rgba(17,17,17,0.04);">

      <!-- Success Icon -->
      <div style="text-align:center; margin-bottom:24px;">
        <div style="width:64px; height:64px; border-radius:50%; background:#eaf7ed; color:#2e7d32; display:inline-flex; align-items:center; justify-content:center;">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
      </div>

      <!-- Reference Code Box -->
      <div class="confirm-ref-box" style="background:#fcf9f2; border:1px dashed var(--primary); border-radius:12px; padding:20px; text-align:center; margin-bottom:32px;">
        <div style="font-size:12px; letter-spacing:0.15em; text-transform:uppercase; color:var(--muted); margin-bottom:6px;">Booking Reference</div>
        <div style="font-family:monospace; font-size:24px; font-weight:700; color:var(--primary); letter-spacing:2px;"><%= booking.reference_code %></div>
        <div style="font-size:12px; color:var(--muted); margin-top:6px;">Please save this reference for your records</div>
      </div>

      <!-- Guest and Schedule details -->
      <div style="margin-bottom:30px;">
        <h3 style="font-family:var(--font-serif); font-size:18px; color:var(--fg); margin-bottom:14px; border-bottom:1px solid rgba(27,20,16,0.08); padding-bottom:8px;">Booking Summary</h3>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; font-size:14px;">
          <div>
            <span style="color:var(--muted); display:block; font-size:12px;">Full Name</span>
            <strong><%= booking.full_name %></strong>
          </div>
          <div>
            <span style="color:var(--muted); display:block; font-size:12px;">Email</span>
            <strong><%= booking.email %></strong>
          </div>
          <div>
            <span style="color:var(--muted); display:block; font-size:12px;">Phone</span>
            <strong><%= booking.phone %></strong>
          </div>
          <div>
            <span style="color:var(--muted); display:block; font-size:12px;">Scheduled For</span>
            <strong><%= booking.preferred_date %> at <%= booking.preferred_time %></strong>
          </div>
          <div>
            <span style="color:var(--muted); display:block; font-size:12px;">Status</span>
            <span style="display:inline-block; padding:3px 10px; border-radius:999px; font-size:11px; font-weight:600; text-transform:uppercase; background:#fff3cd; color:#856404;"><%= booking.status %></span>
          </div>
          <% if (booking.notes) { %>
            <div style="grid-column:1 / -1;">
              <span style="color:var(--muted); display:block; font-size:12px;">Special Requests</span>
              <p style="margin:2px 0 0; color:var(--fg);"><%= booking.notes %></p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Booked Items Breakdown -->
      <% const bookedList = (typeof items !== 'undefined' && items) || (booking && booking.items) || []; %>
      <% if (bookedList && bookedList.length > 0) { %>
      <div style="margin-bottom:30px;">
        <h3 style="font-family:var(--font-serif); font-size:18px; color:var(--fg); margin-bottom:14px; border-bottom:1px solid rgba(27,20,16,0.08); padding-bottom:8px;">Reserved Treatments</h3>
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; font-size:13px;">
            <thead>
              <tr style="border-bottom:1px solid rgba(27,20,16,0.1); color:var(--muted); text-align:left;">
                <th style="padding:8px 4px;">Service</th>
                <th style="padding:8px 4px;">Option</th>
                <th style="padding:8px 4px; text-align:center;">Qty</th>
                <th style="padding:8px 4px; text-align:right;">Total</th>
              </tr>
            </thead>
            <tbody>
              <% bookedList.forEach(it => { %>
                <tr style="border-bottom:1px solid rgba(27,20,16,0.06);">
                  <td style="padding:10px 4px; font-weight:500;"><%= it.service_name %></td>
                  <td style="padding:10px 4px; color:var(--muted);"><%= it.option_label || 'Standard' %></td>
                  <td style="padding:10px 4px; text-align:center;"><%= it.quantity %></td>
                  <td style="padding:10px 4px; text-align:right; font-variant-numeric:tabular-nums;"><%= priceFmt(it.line_total_ngn) %></td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="3" style="padding:14px 4px 6px; text-align:right; font-weight:600; text-transform:uppercase; font-size:12px; color:var(--muted);">Total Amount</td>
                <td style="padding:14px 4px 6px; text-align:right; font-family:var(--font-serif); font-size:18px; font-weight:700; color:var(--primary);"><%= priceFmt(booking.total_amount_ngn) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
      <% } %>

      <div style="display:flex; flex-wrap:wrap; gap:12px; justify-content:center; margin-top:28px;">
        <a href="/" class="btn btn--outline" style="padding:12px 24px;">Return Home</a>
        <a href="/spa_menu" class="btn btn--primary" style="padding:12px 24px;">Book Another Experience</a>
        <button type="button" onclick="window.print()" class="btn btn--ghost" style="padding:12px 20px;">Print Confirmation</button>
      </div>

    </div>
  </div>
</section>

<%- include('includes/footer') %>
