<%- include('includes/header') %>

<!-- ================================================================
     ✨ SECTION 01 — HERO: SPLIT LAYOUT WITH STORY-LIKE HEADER SLIDES
     ================================================================ -->
<section class="hero-split">
  <!-- LEFT: Text Column & Story Chapter Navigator -->
  <div class="hero-split__text">
    <p class="hero-split__eyebrow">A PRIVATE SANCTUARY</p>
    <h1 class="hero-split__title">
      Where Refined<br>
      Living Meets<br>
      Purposeful Connection.
    </h1>
    <div class="hero-split__divider"></div>
    <p class="hero-split__desc">
      Caroline's Place is more than a space — it's an elevated sanctuary for
      women who lead, inspire, and create lasting impact.
    </p>
    <div class="hero-split__cta-row">
      <a href="/spa_menu" class="btn-book btn-book--filled" id="heroPrimaryCta">
        BOOK YOUR EXPERIENCE <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <!-- RIGHT: Story-Like Slideshow with progress bars, cinematic visuals & narrative overlays -->
  <div class="hero-story" id="heroStorySlider" aria-label="Caroline's Place Visual Story">
    <!-- Top Story Progress Bar (Segmented Instagram / Luxury Editorial style) -->
    <div class="hero-story__progress-bar" id="storyProgressBar" aria-hidden="true">
      <div class="hero-story__progress-seg" data-story-target="0"><div class="hero-story__progress-fill"></div></div>
      <div class="hero-story__progress-seg" data-story-target="1"><div class="hero-story__progress-fill"></div></div>
      <div class="hero-story__progress-seg" data-story-target="2"><div class="hero-story__progress-fill"></div></div>
      <div class="hero-story__progress-seg" data-story-target="3"><div class="hero-story__progress-fill"></div></div>
      <div class="hero-story__progress-seg" data-story-target="4"><div class="hero-story__progress-fill"></div></div>
      <div class="hero-story__progress-seg" data-story-target="5"><div class="hero-story__progress-fill"></div></div>
    </div>

    <!-- Top Floating Meta Bar -->
    <div class="hero-story__top-bar">
      <div class="hero-story__location-tag">
        <span class="hero-story__pulse-dot" aria-hidden="true"></span>
        <span>EXCLUSIVE SANCTUARY · LAGOS</span>
      </div>
      <div class="hero-story__controls-right">
        <span class="hero-story__counter" id="storyCounter">01 / 06</span>
        <button type="button" class="hero-story__play-btn" id="storyPlayToggle" aria-label="Pause slide story" title="Pause / Resume">
          <svg class="icon-pause" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
            <rect x="6" y="4" width="4" height="16" rx="1"/>
            <rect x="14" y="4" width="4" height="16" rx="1"/>
          </svg>
          <svg class="icon-play" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="display:none;">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Slides Container -->
    <div class="hero-story__slides">
      <!-- SLIDE 01: The Artisanal Hair & Beauty Studio (Uploaded slid1) -->
      <div class="hero-story__slide hero-story__slide--active" data-slide-index="0">
        <picture>
          <source srcset="/assets/images/slid1.webp" type="image/webp" />
          <img
            src="/assets/images/slid1.jpg"
            alt="Caroline's Place — Artisanal Hair &amp; Beauty Studio"
            class="hero-story__img"
            fetchpriority="high"
            loading="eager"
            onerror="this.onerror=null;this.src='/assets/images/DSC_2935.jpg';"
          />
        </picture>
        <div class="hero-story__overlay">
          <div class="hero-story__card">
            <h3 class="hero-story__title">Artisanal Hair &amp; Beauty Studio</h3>
            <p class="hero-story__desc">
              Step beyond the everyday into our bespoke hair and beauty salon, curated with luxury styling stations and discrete pampering.
            </p>
          </div>
        </div>
      </div>

      <!-- SLIDE 02: N Lounge & Spa Rituals -->
      <div class="hero-story__slide" data-slide-index="1">
        <img
          src="/assets/images/DSC_7595.jpg"
          alt="N Lounge & Spa — Candlelit Treatment Suites"
          class="hero-story__img"
          loading="lazy"
          onerror="this.onerror=null;this.src='/assets/images/DSC_2976.jpg';"
        />
        <div class="hero-story__overlay">
          <div class="hero-story__card">
            <h3 class="hero-story__title">Surrender to Restorative Body Rituals</h3>
            <p class="hero-story__desc">
              Melt tension away with deep-tissue therapies, botanical oils, and candlelit tranquility in bespoke private suites.
            </p>
          </div>
        </div>
      </div>

      <!-- SLIDE 03: The Club Lounge (Uploaded IMG_7451) -->
      <div class="hero-story__slide" data-slide-index="2">
        <picture>
          <source srcset="/assets/images/IMG_7451.webp" type="image/webp" />
          <img
            src="/assets/images/IMG_7451.jpg"
            alt="The Club Lounge — Executive Dining &amp; Gathering"
            class="hero-story__img"
            loading="lazy"
            onerror="this.onerror=null;this.src='/assets/images/DSC_3010.jpg';"
          />
        </picture>
        <div class="hero-story__overlay">
          <div class="hero-story__card">
            <h3 class="hero-story__title">The Club Lounge &amp; Private Bar</h3>
            <p class="hero-story__desc">
              Gather around executive communal tables under warm ambient pendant lighting, with curated refreshments and discrete conversation.
            </p>
          </div>
        </div>
      </div>

      <!-- SLIDE 04: Executive Boardroom -->
      <div class="hero-story__slide" data-slide-index="3">
        <img
          src="/assets/images/DSC_7433.jpg"
          alt="The Executive Boardroom at Caroline's Place"
          class="hero-story__img"
          loading="lazy"
          onerror="this.onerror=null;this.src='/assets/images/DSC_74331.jpg';"
        />
        <div class="hero-story__overlay">
          <div class="hero-story__card">
            <h3 class="hero-story__title">Where Visionary Leaders Meet &amp; Strategize</h3>
            <p class="hero-story__desc">
              Host high-stakes strategy summits and confidential executive conferences with cutting-edge technology and discrete service.
            </p>
          </div>
        </div>
      </div>

      <!-- SLIDE 05: Members' Lounge & Intimate Bar -->
      <div class="hero-story__slide" data-slide-index="4">
        <img
          src="/assets/images/DSC_2929.jpg"
          alt="Members' Lounge & Intimate Bar"
          class="hero-story__img"
          loading="lazy"
          onerror="this.onerror=null;this.src='/assets/images/DSC_3010.jpg';"
        />
        <div class="hero-story__overlay">
          <div class="hero-story__card">
            <h3 class="hero-story__title">Intimate Ambiance &amp; Purposeful Connection</h3>
            <p class="hero-story__desc">
              Savor craft refreshments under warm chandelier lighting, host private discussions, and nurture genuine community.
            </p>
          </div>
        </div>
      </div>

      <!-- SLIDE 06: Private Gym & Fitness Suite (From Image Folder DSC_3048) -->
      <div class="hero-story__slide" data-slide-index="5">
        <img
          src="/assets/images/DSC_3048.jpg"
          alt="State-of-the-Art Private Fitness Suite &amp; Gym"
          class="hero-story__img"
          loading="lazy"
          onerror="this.onerror=null;this.src='/assets/images/DSC_3042.jpg';"
        />
        <div class="hero-story__overlay">
          <div class="hero-story__card">
            <h3 class="hero-story__title">State-of-the-Art Private Fitness Suite</h3>
            <p class="hero-story__desc">
              Energize body and mind in our fully-equipped private gym featuring premium cardio equipment, strength training, and wellness spaces.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Tap Zones for Mobile/Desktop Quick Navigation -->
    <div class="hero-story__tap-zone hero-story__tap-zone--prev" id="storyTapPrev" aria-label="Previous story chapter"></div>
    <div class="hero-story__tap-zone hero-story__tap-zone--next" id="storyTapNext" aria-label="Next story chapter"></div>

    <!-- Navigation Arrows -->
    <button type="button" class="hero-story__nav-btn hero-story__nav-btn--prev" id="storyPrevBtn" aria-label="Previous Slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"/>
      </svg>
    </button>
    <button type="button" class="hero-story__nav-btn hero-story__nav-btn--next" id="storyNextBtn" aria-label="Next Slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6"/>
      </svg>
    </button>
  </div>
</section>

<!-- ================================================================
     ✨ SECTION 02 — 4 FEATURE ICONS (Premium / Community / Privacy / UX)
     ================================================================ -->
<section class="features reveal">
  <div class="features__grid">
    <!-- #1 -- Premium Spaces -->
    <div class="feature">
      <div class="feature__icon" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 18h18l-2-10-4 4-3-7-3 7-4-4L3 18z"/>
          <path d="M3 18h18"/>
        </svg>
      </div>
      <h4 class="feature__title">Premium Spaces</h4>
      <p class="feature__text">Elegantly curated spaces for work, wellness and connection.</p>
    </div>

    <!-- #2 -- Purposeful Community -->
    <div class="feature">
      <div class="feature__icon" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
        </svg>
      </div>
      <h4 class="feature__title">Purposeful Community</h4>
      <p class="feature__text">A network of intentional women supporting each other's growth.</p>
    </div>

    <!-- #3 -- Privacy & Comfort -->
    <div class="feature">
      <div class="feature__icon" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
      </div>
      <h4 class="feature__title">Privacy &amp; Comfort</h4>
      <p class="feature__text">Discreet, secure and beautifully designed for your peace of mind.</p>
    </div>

    <!-- #4 -- Unforgettable Experiences -->
    <div class="feature">
      <div class="feature__icon" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 4 5 5"/>
          <path d="m3 21 10-10"/>
          <path d="M9 3v3M7.5 4.5h3"/>
          <path d="M19 13v3M17.5 14.5h3"/>
          <path d="M5 11v2M4 12h2"/>
        </svg>
      </div>
      <h4 class="feature__title">Unforgettable Experiences</h4>
      <p class="feature__text">From spa days to executive retreats — every moment is elevated.</p>
    </div>
  </div>
</section>

<!-- ================================================================
     ✨ SECTION 03 — CHOOSE YOUR EXPERIENCE: Spaces Designed For You
     ================================================================ -->
<section class="spaces section reveal">
  <div class="container">
    <div class="section__header">
      <p class="section__eyebrow">CHOOSE YOUR EXPERIENCE</p>
      <h2 class="section__title">Spaces Designed For You</h2>
    </div>
    <div class="spaces__grid">
      <!-- CARD 1: The Club House (Gym / Executive Spaces) -->
      <a href="/clubhouse" class="space-card">
        <div class="space-card__img-wrap">
          <img src="/assets/images/DSC_74331.jpg" alt="The Club House" loading="lazy" class="space-card__img" />
        </div>
        <div class="space-card__body">
          <h3 class="space-card__title">The Club House</h3>
          <p class="space-card__desc">
            Exclusive spaces for meetings, private gatherings, and focused productivity.
          </p>
          <span class="space-card__link">EXPLORE CLUB HOUSE <span class="card-arrow" aria-hidden="true">→</span></span>
        </div>
      </a>

      <!-- CARD 2: N Lounge & Spa (Spa beds with petals & mirror) -->
      <a href="/spa" class="space-card">
        <div class="space-card__img-wrap">
          <img src="/assets/images/DSC_7595.jpg" alt="N Lounge &amp; Spa" loading="lazy" class="space-card__img" />
        </div>
        <div class="space-card__body">
          <h3 class="space-card__title">N Lounge &amp; Spa</h3>
          <p class="space-card__desc">
            Relax and rejuvenate with luxury spa, beauty and wellness treatments.
          </p>
          <span class="space-card__link">EXPLORE SPA <span class="card-arrow" aria-hidden="true">→</span></span>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- ================================================================
     ✨ SECTION 04 — MORE THAN A PLACE: Sanctuary That Empowers
     ================================================================ -->
<section class="sanctuary reveal">
  <!-- LEFT: Image (Lounge with circular light fixture) -->
  <div class="sanctuary__img-wrap">
    <img
      src="/assets/images/DSC_2929.jpg"
      alt="Caroline's Place — Lounge Interior"
      loading="lazy"
      class="sanctuary__img"
    />
  </div>

  <!-- RIGHT: Dark Solid Column -->
  <div class="sanctuary__copy">
    <p class="sanctuary__eyebrow">MORE THAN A PLACE</p>
    <div class="sanctuary__divider"></div>
    <h2 class="sanctuary__title">A Sanctuary<br>That Empowers</h2>
    <p class="sanctuary__text">
      Every detail at Caroline's Place is thoughtfully curated to help you
      unwind, connect and thrive in an environment that feels like home.
    </p>
    <a href="/clubhouse" class="btn btn--outline-white btn--text-left">
      DISCOVER OUR STORY <span class="btn-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<!-- ================================================================
     ✨ SECTION 05 — READY TO EXPERIENCE MORE?
     ================================================================ -->
<section class="journey section reveal">
  <div class="container container--sm text-center">
    <p class="section__eyebrow">READY TO EXPERIENCE MORE?</p>
    <h2 class="section__title">Your Journey Starts Here</h2>
    <p class="journey__text">
      Book your experience today and become part of a community where
      leaders grow together.
    </p>
    <a href="/spa_menu" class="btn-book btn-book--filled">
      BOOK YOUR EXPERIENCE <span class="btn-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<%- include('includes/footer') %>
